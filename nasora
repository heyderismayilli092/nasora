#!/usr/bin/env python3

import socket
import subprocess


# retrieve active interface ip
def get_active_ip():
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
            s.connect(("8.8.8.8", 80))
            return s.getsockname()[0]
    except OSError:
        return "127.0.0.1"


try:
    hostip = get_active_ip()
    subprocess.run(["uvicorn", "nasora.server.main:app", "--reload", "--host", hostip, "--port", "2215",])
except KeyboardInterrupt:
    print("\nStopped nasora server")

